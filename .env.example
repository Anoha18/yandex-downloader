# Переменные окружения приложения (префикс YD_).
# Скопируйте этот файл в .env — .env добавлен в .gitignore и не попадёт в git.
#
# Реальные переменные окружения имеют приоритет над значениями из .env.

# ── Учётные данные OAuth (обязательны для авторизации) ──────────────────────
# Где взять:
#   1. https://oauth.yandex.ru/ → «Создать приложение», тип «Для доступа к API».
#   2. Доступ к данным: cloud_api:disk.read (и, по желанию, cloud_api:disk.info).
#   3. Платформы → Веб-сервисы → Redirect URI: https://oauth.yandex.ru/verification_code
#   4. Сохранить и скопировать ClientID; секретный ключ — там же в свойствах приложения.
YD_OAUTH_CLIENT_ID=
YD_OAUTH_CLIENT_SECRET=

# ── Необязательные переопределения (обычно задаются в config.json) ──────────
# YD_DOWNLOAD_DIR=/mnt/backup/yandex
# YD_PHOTOS_DIR=/mnt/backup/_unlimited_photos
# YD_PROFILE=normal
# YD_LOG_DIR=logs
